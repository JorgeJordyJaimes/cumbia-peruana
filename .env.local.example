# Configuración de Supabase para desarrollo local
# Solicitar las credenciales autorizadas al propietario/mantenedor del proyecto

NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui

# Correo autorizado para el panel /admin (solo servidor)
ADMIN_EMAIL=correo@ejemplo.com
